<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Remote sources -->
    <remote name="muppets"		fetch="https://github.com/TheMuppets"		revision="lineage-22.2" />
    <remote name="los"                  fetch="https://github.com/LineageOS"              revision="lineage-22.2" />
    <remote name="pixelthrived" fetch="https://github.com/pixelthrived"     revision="lineage-23.0" />

    <!-- Device trees -->
    <project name="android_device_motorola_devon"	path="device/motorola/devon"	remote="los" />
    <project name="android_device_motorola_hawao"       path="device/motorola/hawao"    remote="los" />
    <project name="android_device_motorola_rhode" 	path="device/motorola/rhode"	remote="los" />
    <project name="android_device_motorola_sm6225-common"	path="device/motorola/sm6225-common"	remote="los" />

    <!-- Vendor trees -->
    <project name="proprietary_vendor_motorola_devon"	path="vendor/motorola/devon"	remote="muppets" />
    <project name="proprietary_vendor_motorola_hawao"	path="vendor/motorola/hawao"	remote="muppets" />
    <project name="proprietary_vendor_motorola_rhode"	path="vendor/motorola/rhode"	remote="muppets" />
    <project name="proprietary_vendor_motorola_sm6225-common"	path="vendor/motorola/sm6225-common"	remote="muppets" />
    
    <!-- Kernel source -->
    <project name="experimental_kernel_motorola_sm6225"	path="kernel/motorola/sm6225"	remote="pixelthrived" 		revision="lineage-23.0" />

    <!-- Hardware dependency -->
    <project name="android_hardware_motorola"	path="hardware/motorola"	remote="los" />
</manifest>
